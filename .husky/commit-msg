#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Read commit message
commit_msg=$(cat "$1")
commit_msg_length=${#commit_msg}

# Check minimum length
if [ $commit_msg_length -lt 3 ]; then
  echo "❌ Commit message is too short (minimum 3 characters)"
  echo "   Your message: '$commit_msg'"
  exit 1
fi

# Check maximum length (first line should be <= 72 chars for Git best practices)
first_line=$(echo "$commit_msg" | head -n1)
if [ ${#first_line} -gt 72 ]; then
  echo "⚠️  Warning: First line of commit message is longer than 72 characters (${#first_line} chars)"
  echo "   Consider keeping the subject line shorter for better readability"
  echo "   First line: '$first_line'"
fi

