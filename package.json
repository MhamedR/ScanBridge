{
  "name": "scanbridge",
  "version": "1.0.0",
  "description": "Desktop app to connect mobile phones and trigger document scans",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "ng lint",
    "electron": "wait-on http://localhost:4200 && electron .",
    "electron:serve": "concurrently \"npm run start\" \"npm run electron\"",
    "electron:build": "ng build --base-href ./ && electron-builder",
    "electron:pack": "ng build --base-href ./ && electron-builder --dir",
    "prepare": "husky"
  },
  "keywords": [
    "electron",
    "angular",
    "scanner",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/cdk": "^20.2.11",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "qrcode": "^1.5.3",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0",
    "ws": "^8.14.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^20.0.0",
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "autoprefixer": "^10.4.16",
    "buffer": "^6.0.3",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-preset-angular": "^14.2.1",
    "lint-staged": "^16.2.6",
    "postcss": "^8.4.32",
    "selfsigned": "^4.0.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.3.3",
    "uuid": "^9.0.1",
    "wait-on": "^7.2.0"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "npx ng lint"
    ],
    "*.ts": [
      "bash -c 'npx tsc --noEmit --project tsconfig.app.json' || true"
    ]
  },
  "build": {
    "appId": "com.scanbridge.app",
    "productName": "ScanBridge",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "mobile.html",
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
